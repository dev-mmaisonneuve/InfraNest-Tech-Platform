NEXT_PUBLIC_SITE_URL=https://infranests.com
NEXT_PUBLIC_FORMSPREE_FALLBACK_EMAIL=info@infranests.com

# AWS. In Amplify the compute role supplies credentials and Lambda sets
# AWS_REGION automatically, so neither is configured by hand there. Locally the
# default credential chain applies (a profile in ~/.aws/credentials, say).
AWS_REGION=us-east-1
LEADS_TABLE_NAME=infranest-leads
QUOTE_REQUESTS_TABLE_NAME=infranest-quote-requests

NOTIFICATION_EMAIL=info@infranests.com
# Must be an address on a domain verified in SES. SES refuses any other sender,
# so unlike the previous Resend setup there is no fallback address to fall back to.
NOTIFICATION_FROM=InfraNest Website <notifications@infranests.com>

TURNSTILE_SECRET_KEY=your-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=infranests.com
