NEXT_PUBLIC_SITE_URL=https://infranests.com
NEXT_PUBLIC_FORMSPREE_FALLBACK_EMAIL=info@infranests.com

# AWS. In Amplify the compute role supplies credentials and Lambda sets
# AWS_REGION automatically, so neither is configured by hand there. Locally the
# default credential chain applies (a profile in ~/.aws/credentials, say).
AWS_REGION=us-east-1
LEADS_TABLE_NAME=infranest-leads
QUOTE_REQUESTS_TABLE_NAME=infranest-quote-requests
ACKNOWLEDGMENTS_TABLE_NAME=infranest-acknowledgments

NOTIFICATION_EMAIL=info@infranests.com
# Must be an address on a domain verified in SES. SES refuses any other sender,
# so unlike the previous Resend setup there is no fallback address to fall back to.
NOTIFICATION_FROM=InfraNest Technologies <notifications@infranests.com>

TURNSTILE_SECRET_KEY=your-turnstile-secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Optional. Hostnames a solved Turnstile challenge may report, comma separated.
# Left unset, the allowlist is the host of NEXT_PUBLIC_SITE_URL plus its www
# counterpart (both serve the site), and localhost outside production. Setting
# this replaces that pair outright, so any value must list every host the forms
# are served from — the Amplify default domain included, if it is used. Never
# put localhost in a production value.
# TURNSTILE_HOSTNAMES=infranests.com,www.infranests.com,main.duvgb0v6cgit7.amplifyapp.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=infranests.com
